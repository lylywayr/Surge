#!name=吾爱破解签到
#!desc=打开 52pojie.cn 登录后自动抓取 Cookie，每天定时自动签到。脚本来自 Yuheng0101/X，本模块仅做参数封装。
#!author=lylywayr
#!category=签到
#!arguments=hour:9,minute:0
#!arguments-desc=hour / minute：每日签到时间（默认 09:00，24 小时制）。修改后模块会自动重载 cron 表达式。

[MITM]
hostname = www.52pojie.cn

[Script]
吾爱破解获取Cookie = type=http-request, pattern=^https:\/\/www\.52pojie\.cn\/home\.php\?, requires-body=1, max-size=0, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/52pojie.js, timeout=15, script-update-interval=0
吾爱破解签到 = type=cron, cronexp={{{minute}}} {{{hour}}} * * *, wake-system=1, script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Tasks/52pojie.js, timeout=60, script-update-interval=0
