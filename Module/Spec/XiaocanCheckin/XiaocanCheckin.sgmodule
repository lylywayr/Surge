#!name=小蚕霸王餐签到
#!desc=打开小蚕霸王餐 App 触发 RPC 请求自动抓 Cookie，每天 08:00 自动签到。脚本来自 Sliverkiss。
#!author=lylywayr
#!category=签到

[MITM]
hostname = %APPEND% gw.xiaocantech.com

[Script]
小蚕霸王餐获取 = type=http-request, pattern=^https:\/\/gw\.xiaocantech\.com\/rpc, requires-body=1, max-size=0, binary-body-mode=1, argument=xcbwc_data, script-path=https://gist.githubusercontent.com/Sliverkiss/27c601d97a3f8960b212e5cac5b6c470/raw/xcbwc.js, script-update-interval=0
小蚕霸王餐定时 = type=cron, cronexp=0 8 * * *, wake-system=1, argument=xcbwc_data, script-path=https://gist.githubusercontent.com/Sliverkiss/27c601d97a3f8960b212e5cac5b6c470/raw/xcbwc.js, script-update-interval=0
